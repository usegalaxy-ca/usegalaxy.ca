{{ galaxy_log_dir }}/*.log {
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    olddir {{ galaxy_log_dir }}/old
    createolddir 0750 {{ galaxy_user_name }} {{ galaxy_user_name }}
    su {{ galaxy_user_name }} {{ galaxy_user_name }}
    dateext
    dateyesterday
    dateformat .%Y%m
}
