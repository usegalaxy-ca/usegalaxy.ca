"""Assign newly registered Galaxy OIDC users to allocation groups based on EduGAIN IDP.

Allocation examples:
- `alice@usherbrooke.ca` via Université de Sherbrooke (CAF SAML IdP in EduGAIN):
  -> `CanadianUsersAllocationGroup` (matched by `entityid`, `code == "CAF"`).
- `bob@mail.utoronto.ca` or `carol@courrier.uqam.ca` via Microsoft on CILogon:
  -> `CanadianUsersAllocationGroup` (Microsoft IdP fallback matches parent domain
     `utoronto.ca` / `uqam.ca` against CAF IdP `scopes` in `edugain_idps.json`).
- `dave@stanford.edu` via Stanford University (InCommon SAML IdP in EduGAIN):
  -> `EdugainUsersAllocationGroup` (matched by `entityid`, `code != "CAF"`).
- `eve@hotmail.ca` via Microsoft, `frank@gmail.com` via Google, or ORCID/GitHub logins:
  -> skipped silently (keeps Galaxy's default allocation; not added to either group).

Workflow:
1. Query PostgreSQL (read-only) for active users created within the last 7 days who have
   an OIDC token (`oidc_user_authnz_tokens`) and are NOT yet assigned to either
   `CanadianUsersAllocationGroup` or `EdugainUsersAllocationGroup`.
2. Base64URL-decode each user's JWT `id_token` payload in memory, verify that its `iss`
   claim matches `https://cilogon.org`, and extract its `idp` and `email` claims; exit
   immediately (without reading `edugain_idps.json` or calling the Galaxy API) if no
   users have a valid `idp` claim.
3. Load `edugain_idps.json`, index entries by `entityid` (O(1) lookup) and CAF IdP
   domain `scopes`, and classify users into target allocation groups. Exit immediately
   without calling the Galaxy API if no users match.
4. Initialize the Galaxy BioBlend client and allocation groups once (failing fast if
   Galaxy is unreachable, unauthorized, or in maintenance mode), then assign matched
   users via the API.

Exit codes:
- `0`: Run completed cleanly (including fast-path exits when no users need assignment).
- `1`: PostgreSQL failure, invalid/missing `edugain_idps.json`, Galaxy API outage or
       auth failure, or one or more per-user assignment errors.
"""

import base64
from contextlib import closing
from datetime import datetime, timedelta, timezone
import json
import logging
from pathlib import Path
import re
import sys

import bioblend.galaxy
import psycopg2
import requests

logging.basicConfig(
    format="%(asctime)s:%(levelname)s:%(message)s",
    level=logging.INFO,
    force=True,
)
# BioBlend logs raw multi-line HTTP/HTML responses via its own logger before raising
# ConnectionError; silence it so errors are logged once in summarized form below.
logging.getLogger("bioblend").setLevel(logging.CRITICAL)


###################################################################################
# Configuration (templated by Ansible)
###################################################################################

# Local NFS copy of EduGAIN's `action=list_entities` JSON feed, refreshed by
# `/opt/fetch-edugain-idps.bash`.
EDUGAIN_IDPS_FILE = Path("{{ galaxy_root }}/var/usegalaxy.ca/edugain_idps.json")

# Galaxy REST API settings (only contacted in Stage 4 when matched users exist).
GALAXY_URL = "https://{{ usegalaxy_domain }}"
GALAXY_ADMIN_API_KEY = "{{ GALAXY_ADMIN_API_KEY }}"
GALAXY_API_TIMEOUT = 30  # Per-request HTTP timeout in seconds.

# Galaxy PostgreSQL settings (always opened with read-only session + statement timeout).
GALAXY_DB_HOST = "{{ groups['dbservers'][0] }}"
GALAXY_DB_NAME = "{{ galaxy_db_name }}"
GALAXY_DB_USER = "{{ galaxy_user_name }}"
GALAXY_DB_PASSWORD = "{{ galaxy_postgres_password }}"
GALAXY_DB_CONNECT_TIMEOUT = 10        # TCP/auth connection timeout in seconds.
GALAXY_DB_STATEMENT_TIMEOUT_MS = 15000  # Server-side query timeout in milliseconds.

# Galaxy group names that control Canadian vs. international EduGAIN quota allocations.
GROUP_NAME_CANADIAN_USERS_ALLOCATION = "CanadianUsersAllocationGroup"
GROUP_NAME_EDUGAIN_USERS_ALLOCATION = "EdugainUsersAllocationGroup"

# Expected OIDC JWT `iss` (issuer) claim for CILogon tokens; guards against tokens
# minted by any other OIDC provider if more providers are enabled in Galaxy later.
CILOGON_ISSUER = "https://cilogon.org"

# Microsoft IdP URIs emitted by CILogon in `id_token["idp"]`. Production currently emits
# the `http://` form; keep `https://` as well in case CILogon migrates schemes later.
MICROSOFT_IDP_ENTITY_IDS = frozenset(
    {
        "http://login.microsoftonline.com/common/oauth2/v2.0/authorize",
        "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
    }
)

# EduGAIN `roles` bitmask: 4 = IDPSSODescriptor, 2 = SPSSODescriptor,
# 1 = AttributeAuthorityDescriptor. Checking `roles & 4` captures both pure IdPs (`4`)
# and IdP+AA entities (`5`, e.g. U of T, UdeS, UWO, SFU, ULaval, UdeM) while skipping SPs.
EDUGAIN_IDP_ROLE_BIT = 4

# Strict multi-label DNS domain regex (requires at least two dot-separated labels).
# Rejects SAML regex scopes (`shibmd:Scope regexp="true"`), malformed strings, and bare TLDs.
VALID_SCOPE_RE = re.compile(r"^[a-z0-9-]+(?:\.[a-z0-9-]+)+$")

# 7-day lookback acts as a recovery safety net if cron, the Galaxy API, or the
# EduGAIN IDP file is temporarily unavailable. Already-assigned users are filtered
# out in SQL (`NOT EXISTS`), so they are not re-processed on subsequent cron runs.
LOOKBACK_WINDOW = timedelta(days=7)

# Select only the most recent non-null OIDC token per active user
# (`DISTINCT ON (u.id) ... ORDER BY u.id, t.id DESC`) created after the UTC cutoff
# who does not already belong to either allocation group.
# Uses `IS NOT TRUE` (instead of `NOT ...`) so rows where `deleted IS NULL` are not
# silently dropped by SQL three-valued logic.
UNASSIGNED_USERS_QUERY = """
SELECT DISTINCT ON (u.id)
    u.email,
    t.extra_data
FROM galaxy_user u
JOIN oidc_user_authnz_tokens t ON u.id = t.user_id
WHERE u.create_time > %s
  AND u.deleted IS NOT TRUE
  AND t.extra_data IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM user_group_association uga
      JOIN galaxy_group g ON g.id = uga.group_id
      WHERE uga.user_id = u.id
        AND g.deleted IS NOT TRUE
        AND g.name IN (%s, %s)
  )
ORDER BY u.id, t.id DESC
"""


def decode_id_token_payload(extra_data, user_label=None):
    """Extract and Base64URL-decode the JWT payload from `oidc_user_authnz_tokens.extra_data`.

    Galaxy's SQLAlchemy `JSONType` column stores `extra_data` as `BYTEA` on PostgreSQL
    (returned by psycopg2 as `memoryview`), though other schemas/drivers may yield `bytes`,
    `str` (`TEXT`), or `dict` (`JSON`/`JSONB`). Decodes the JWT payload segment using
    RFC 7515 Base64URL (`urlsafe_b64decode`) with modulo-4 `=` padding.

    Returns an empty dict if `id_token` is absent or malformed. When `user_label` is
    provided, logs a warning for malformed `extra_data`/`id_token` while remaining silent
    when `id_token` is simply absent (`None`).
    """
    if extra_data is None:
        return {}
    # Step 1: Parse outer `extra_data` JSON object from whichever Python type psycopg2 returned.
    try:
        if isinstance(extra_data, (bytes, bytearray, memoryview)):
            data_dict = json.loads(bytes(extra_data).decode("utf-8"))
        elif isinstance(extra_data, str):
            data_dict = json.loads(extra_data)
        elif isinstance(extra_data, dict):
            data_dict = extra_data
        else:
            if user_label is not None:
                logging.warning("Skipping user %s with unsupported OIDC extra_data type %s", user_label, type(extra_data).__name__)
            return {}
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        if user_label is not None:
            logging.warning("Skipping user %s with malformed OIDC extra_data: %s", user_label, _summarize_error(exc))
        return {}

    if not isinstance(data_dict, dict):
        if user_label is not None:
            logging.warning("Skipping user %s with non-object OIDC extra_data", user_label)
        return {}

    # Step 2: Extract `id_token` JWT string (`header.payload.signature`). Absent `id_token`
    # is treated as normal (no warning); wrong type or broken structure logs a warning.
    id_token = data_dict.get("id_token")
    if id_token is None:
        return {}
    if not isinstance(id_token, str):
        if user_label is not None:
            logging.warning("Skipping user %s with non-string OIDC id_token", user_label)
        return {}

    parts = id_token.split(".")
    if len(parts) < 2 or not parts[1]:
        if user_label is not None:
            logging.warning("Skipping user %s with malformed OIDC id_token structure", user_label)
        return {}

    # Step 3: Base64URL-decode the payload segment (`parts[1]`). JWT segments omit '='
    # padding and use '-'/'_' instead of '+'/'/'. A length congruent to 1 mod 4 is
    # mathematically invalid Base64 and would raise binascii.Error.
    payload_b64 = parts[1]
    if len(payload_b64) % 4 == 1:
        if user_label is not None:
            logging.warning("Skipping user %s with invalid Base64URL OIDC id_token length", user_label)
        return {}
    padded = payload_b64 + "=" * (-len(payload_b64) % 4)
    try:
        payload = json.loads(base64.urlsafe_b64decode(padded).decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as exc:
        if user_label is not None:
            logging.warning("Skipping user %s with undecodable OIDC id_token payload: %s", user_label, _summarize_error(exc))
        return {}
    if not isinstance(payload, dict):
        if user_label is not None:
            logging.warning("Skipping user %s with non-object OIDC id_token payload", user_label)
        return {}
    return payload


def _summarize_error(exc, max_len=200):
    """Collapse whitespace and truncate verbose HTTP/HTML error bodies for compact logging."""
    msg = " ".join(str(exc).split())
    return f"{msg[:max_len]}..." if len(msg) > max_len else msg


def build_caf_scopes(raw_idps):
    """Extract normalized CAF IdP domain scopes from EduGAIN `list_entities` JSON.

    Each element in `raw_idps` is a 1-element list wrapping an entity dict. For Canadian
    Access Federation (`code == "CAF"`) Identity Providers (`roles & 4`, which matches
    both `4`=IdP and `5`=IdP+AttributeAuthority), EduGAIN joins multiple SAML `shibmd:Scope`
    domains with `==` (e.g. `ens.uqam.ca==uqam.ca`). Only plain multi-label DNS domains
    passing `VALID_SCOPE_RE` are included.
    """
    caf_scopes = set()
    for entry in raw_idps:
        if not (isinstance(entry, list) and entry and isinstance(entry[0], dict)):
            continue
        idp = entry[0]
        if idp.get("code") != "CAF":
            continue
        try:
            roles = int(idp.get("roles") or 0)
        except (TypeError, ValueError):
            continue
        if not (roles & EDUGAIN_IDP_ROLE_BIT):
            continue
        scopes_str = idp.get("scopes")
        if not isinstance(scopes_str, str) or not scopes_str:
            continue
        for raw_scope in re.split(r"==|\s+", scopes_str):
            scope = raw_scope.strip().lower().rstrip(".")
            if VALID_SCOPE_RE.match(scope):
                caf_scopes.add(scope)
    return caf_scopes


def matches_domain_scope(email, scopes):
    """Return True if `email`'s domain or a parent domain (at least 2 labels) is in `scopes`.

    Walking DNS labels instead of `str.endswith()` prevents suffix collisions and bare-TLD
    matches:
    - `user@mail.utoronto.ca` checks `mail.utoronto.ca`, then `utoronto.ca` -> True.
    - `user@courrier.uqam.ca` checks `courrier.uqam.ca`, then `uqam.ca` -> True.
    - `user@evilutoronto.ca` checks `evilutoronto.ca` -> False.
    - `user@hotmail.ca` checks `hotmail.ca` and stops before bare TLD `ca` -> False.
    """
    if not isinstance(email, str) or "@" not in email:
        return False
    domain = email.rsplit("@", 1)[1].strip().lower().rstrip(".")
    if not VALID_SCOPE_RE.match(domain):
        return False
    labels = domain.split(".")
    for i in range(len(labels) - 1):
        if ".".join(labels[i:]) in scopes:
            return True
    return False


def ensure_allocation_groups(gal):
    """Return Galaxy API IDs for the Canadian and EduGAIN allocation groups, creating them if absent.

    Called once per run (only when matched users exist) so we avoid repeated group lookups
    or group-member listings on every user.
    """
    groups_by_name = {group["name"]: group["id"] for group in gal.groups.get_groups()}

    canadian_gid = groups_by_name.get(GROUP_NAME_CANADIAN_USERS_ALLOCATION)
    if canadian_gid is None:
        canadian_gid = gal.groups.create_group(GROUP_NAME_CANADIAN_USERS_ALLOCATION)[0]["id"]

    edugain_gid = groups_by_name.get(GROUP_NAME_EDUGAIN_USERS_ALLOCATION)
    if edugain_gid is None:
        edugain_gid = gal.groups.create_group(GROUP_NAME_EDUGAIN_USERS_ALLOCATION)[0]["id"]

    return canadian_gid, edugain_gid


def main():
    ###################################################################################
    # 1. Fetch OIDC tokens for recent users not yet assigned to an allocation group.
    #    Galaxy stores `galaxy_user.create_time` as a naive UTC timestamp
    #    (`TIMESTAMP WITHOUT TIME ZONE`), so compute a naive UTC cutoff and pass all
    #    parameters via `%s` placeholders. Enforce read-only mode on both PostgreSQL
    #    (`default_transaction_read_only=on`) and the psycopg2 session (`readonly=True`).
    cutoff_utc = datetime.now(timezone.utc).replace(tzinfo=None) - LOOKBACK_WINDOW

    try:
        with closing(
            psycopg2.connect(
                database=GALAXY_DB_NAME,
                user=GALAXY_DB_USER,
                password=GALAXY_DB_PASSWORD,
                host=GALAXY_DB_HOST,
                port=5432,
                connect_timeout=GALAXY_DB_CONNECT_TIMEOUT,
                options=(
                    f"-c statement_timeout={GALAXY_DB_STATEMENT_TIMEOUT_MS} "
                    "-c default_transaction_read_only=on"
                ),
            )
        ) as conn:
            conn.set_session(readonly=True, autocommit=True)
            with conn.cursor() as cursor:
                cursor.execute(
                    UNASSIGNED_USERS_QUERY,
                    (
                        cutoff_utc,
                        GROUP_NAME_CANADIAN_USERS_ALLOCATION,
                        GROUP_NAME_EDUGAIN_USERS_ALLOCATION,
                    ),
                )
                rows = cursor.fetchall()
    except psycopg2.Error as exc:
        logging.error("PostgreSQL query failed: %s", _summarize_error(exc))
        return 1

    # Fast path: exit before decoding tokens, reading `edugain_idps.json`, or calling
    # the Galaxy API when there are no unassigned users in the lookback window.
    if not rows:
        return 0

    ###################################################################################
    # 2. Decode JWT payloads in memory before touching NFS `edugain_idps.json` or the
    #    Galaxy API. Warn and skip on malformed tokens, unexpected issuers, or missing
    #    `idp` claims. Log only the email local-part (`user_label`) to avoid printing
    #    full addresses.
    users_with_idp = []
    for user_email, token_extra_data in rows:
        user_label = user_email.split("@")[0]
        try:
            id_token_infos = decode_id_token_payload(token_extra_data, user_label=user_label)
        except Exception:
            logging.exception("Failed to decode OIDC token for user %s", user_label)
            continue
        if not id_token_infos:
            continue
        issuer = id_token_infos.get("iss")
        if issuer != CILOGON_ISSUER:
            logging.warning(
                "Skipping user %s with unexpected OIDC issuer %r",
                user_label,
                issuer,
            )
            continue
        idp_entity_id = id_token_infos.get("idp")
        if not isinstance(idp_entity_id, str) or not idp_entity_id:
            # A CILogon token without an `idp` claim usually indicates broken OIDC scope
            # configuration (`org.cilogon.userinfo` not requested/released).
            logging.warning(
                "Skipping user %s with missing or invalid OIDC idp claim",
                user_label,
            )
            continue
        # Carry `id_token["email"]` (signed OIDC assertion) rather than relying on
        # mutable `galaxy_user.email` for Microsoft domain matching in Stage 3.
        users_with_idp.append((user_email, idp_entity_id, id_token_infos.get("email")))

    if not users_with_idp:
        return 0

    ###################################################################################
    # 3. Load EduGAIN IDPs JSON file, pre-index by `entityid` and CAF IdP `scopes` for
    #    O(1) lookup, and filter to matched users before calling the Galaxy API.
    #    For details on EduGAIN IDPs info definition: https://technical.edugain.org/api.php
    try:
        with EDUGAIN_IDPS_FILE.open(encoding="utf-8") as f:
            raw_idps = json.load(f)
    except Exception:
        logging.exception("Failed to load EduGAIN IDPs from %s", EDUGAIN_IDPS_FILE)
        return 1

    # Fail loudly if `edugain_idps.json` contains an upstream error object (e.g.
    # `{"error": ...}`) or no valid entity dicts, instead of silently skipping everyone.
    if not isinstance(raw_idps, list):
        logging.error("Unexpected EduGAIN IDPs format in %s: expected list", EDUGAIN_IDPS_FILE)
        return 1

    idp_by_entity = {
        idp[0]["entityid"]: idp[0]
        for idp in raw_idps
        if isinstance(idp, list) and idp and isinstance(idp[0], dict) and "entityid" in idp[0]
    }
    if not idp_by_entity:
        logging.error("EduGAIN IDPs file %s contained no valid IDP entries", EDUGAIN_IDPS_FILE)
        return 1

    caf_scopes = build_caf_scopes(raw_idps)
    if not caf_scopes:
        logging.warning("No valid CAF scopes found in %s; Microsoft fallback disabled", EDUGAIN_IDPS_FILE)

    # Two-tier matching:
    # 1. Exact EduGAIN `entityid` lookup (`CAF` -> Canadian, any other federation -> EduGAIN).
    # 2. For Microsoft CILogon logins (whose `idp` is Microsoft's OAuth URI, not in EduGAIN),
    #    fall back to matching the JWT-asserted `email` domain against CAF IdP `scopes`
    #    (e.g. `mail.utoronto.ca` -> `utoronto.ca`, `courrier.uqam.ca` -> `uqam.ca`).
    # Non-matching logins (Google, ORCID, GitHub, consumer Microsoft accounts like
    # `@hotmail.ca`/`@outlook.ca`) stay silent on purpose: because unassigned users remain
    # in the 7-day SQL window for 336 runs (48 runs/day), logging them would flood the log.
    assignments = []
    for user_email, idp_entity_id, token_email in users_with_idp:
        idp_entry = idp_by_entity.get(idp_entity_id)
        if idp_entry is not None:
            if idp_entry.get("code") == "CAF":
                assignments.append(
                    (user_email, GROUP_NAME_CANADIAN_USERS_ALLOCATION, "Canadian Users", "EduGAIN CAF IdP")
                )
            else:
                assignments.append(
                    (user_email, GROUP_NAME_EDUGAIN_USERS_ALLOCATION, "Edugain Users", "EduGAIN IdP")
                )
        elif idp_entity_id in MICROSOFT_IDP_ENTITY_IDS:
            if not isinstance(token_email, str) or not token_email:
                logging.warning(
                    "Skipping Microsoft user %s with missing OIDC email claim",
                    user_email.split("@")[0],
                )
            elif matches_domain_scope(token_email, caf_scopes):
                assignments.append(
                    (
                        user_email,
                        GROUP_NAME_CANADIAN_USERS_ALLOCATION,
                        "Canadian Users",
                        "Microsoft IdP + CAF email scope",
                    )
                )

    if not assignments:
        return 0

    ###################################################################################
    # 4. Initialize the Galaxy API client and allocation group IDs once; fail fast if
    #    Galaxy is unavailable (maintenance mode, restart, or network outage).
    #    Keep GET retry count low (`max_get_attempts=2`) so outages fail quickly instead
    #    of blocking the cron job until the wrapper's 600s timeout kills it.
    gal = bioblend.galaxy.GalaxyInstance(GALAXY_URL, GALAXY_ADMIN_API_KEY, verify=True)
    gal.timeout = GALAXY_API_TIMEOUT
    gal.max_get_attempts = 2
    gal.get_retry_delay = 2

    try:
        canadian_gid, edugain_gid = ensure_allocation_groups(gal)
    except (bioblend.ConnectionError, requests.RequestException) as exc:
        logging.warning("Galaxy API unavailable; aborting run: %s", _summarize_error(exc))
        return 1

    group_ids = {
        GROUP_NAME_CANADIAN_USERS_ALLOCATION: canadian_gid,
        GROUP_NAME_EDUGAIN_USERS_ALLOCATION: edugain_gid,
    }

    had_errors = False
    for user_email, target_group_name, group_label, match_source in assignments:
        user_label = user_email.split("@")[0]
        try:
            # Look up the user's encoded Galaxy API ID. Because Galaxy's `/api/users?f_email=...`
            # performs a substring (`LIKE %...%`) search, filter for an exact email match.
            candidates = gal.users.get_users(f_email=user_email)
            matched_user = next(
                (u for u in candidates if (u.get("email") or "").lower() == user_email.lower()),
                None,
            )
            if matched_user is None:
                logging.warning("No exact Galaxy user match found for %s", user_label)
                continue

            gal.groups.add_group_user(group_ids[target_group_name], matched_user["id"])
            logging.info(
                "User %s is added to the %s allocation group (%s)",
                user_label,
                group_label,
                match_source,
            )
        except requests.RequestException as exc:
            # Network/TLS/timeout failure mid-batch: abort remaining users until next run.
            logging.warning(
                "Galaxy API unreachable; aborting remaining users: %s",
                _summarize_error(exc),
            )
            return 1
        except bioblend.ConnectionError as exc:
            status_code = getattr(exc, "status_code", None)
            if status_code in (401, 403):
                # Invalid or revoked admin API key: retrying remaining users cannot succeed.
                logging.error(
                    "Galaxy API authentication/authorization failed (status=%s); aborting remaining users: %s",
                    status_code,
                    _summarize_error(exc),
                )
                return 1
            if status_code is None or status_code in (502, 503, 504):
                # Gateway/maintenance/non-JSON HTML response: abort until Galaxy recovers.
                logging.warning(
                    "Galaxy API unavailable (status=%s); aborting remaining users: %s",
                    status_code,
                    _summarize_error(exc),
                )
                return 1
            # Per-user HTTP error (e.g. 400/404/500): record error and continue batch.
            had_errors = True
            logging.error(
                "Failed to assign %s allocation group for user %s (status=%s): %s",
                group_label,
                user_label,
                status_code,
                _summarize_error(exc),
            )
        except Exception:
            # Isolate unexpected per-user errors so a single record cannot block the batch.
            had_errors = True
            logging.exception("Failed to process allocation group for user %s", user_label)

    return 1 if had_errors else 0


if __name__ == "__main__":
    sys.exit(main())
